# Strava (docs/BETRIEB.md, "Strava"). Copy to .env; on the server the file
# lies next to compose.yaml with mode 600. The token itself is not here, it
# lives in DATA_DIR/strava-token.json because Strava rotates it.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Any random string; Strava echoes it when validating the webhook callback.
STRAVA_VERIFY_TOKEN=
# Bearer secret the host cron sends to POST /api/strava/sync.
STRAVA_SYNC_SECRET=
# Token file and activity cache. Default "data" in dev, /data in the container.
DATA_DIR=data
