{
  "permissions": {
    "allow": [
      "Bash(pnpm dev:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec eslint:*)"
    ],
    "deny": [
      "Read(./.next/**)",
      "Read(./node_modules/**)",
      "Read(./coverage/**)",
      "Read(./**/*.blend1)",
      "Edit(./.env)",
      "Edit(./.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__blender__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=.claude/hooks/blender-guard.sh; [ -f \"$f\" ] || f=\"${CLAUDE_PROJECT_DIR}/$f\"; bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
